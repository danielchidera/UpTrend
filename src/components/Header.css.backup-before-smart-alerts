/* =========================================================
   HEADER
========================================================= */

.command-header {
  height: 92px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 38px;

  border-bottom: 1px solid var(--line);

  animation:
    headerReveal 0.7s ease both;

  transition:
    background-color 0.3s ease,
    border-color 0.3s ease;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.header-overline {
  margin-bottom: 4px;

  color: var(--green);

  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.command-header h1 {
  margin: 0;

  color: var(--text);

  font-size: 22px;
  letter-spacing: -0.7px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-icon {
  position: relative;

  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  border: 1px solid var(--line);
  border-radius: 11px;

  background: var(--panel);
  color: var(--muted);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background-color 0.3s ease;
}

.header-icon:hover {
  transform: translateY(-2px);
  border-color: var(--line-strong);
}

.notification i {
  position: absolute;

  top: 8px;
  right: 8px;

  width: 5px;
  height: 5px;

  border-radius: 50%;
  background: var(--green);

  animation:
    onlinePulse 2s ease-in-out infinite;
}

.notification-icon {
  font-size: 16px;
}

/* =========================================================
   THEME CONTROL
========================================================= */

.theme-control {
  position: relative;
}

.theme-toggle {
  height: 38px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 0 11px;

  border: 1px solid var(--line);
  border-radius: 11px;

  background: var(--panel);
  color: var(--text);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background-color 0.3s ease;
}

.theme-toggle:hover {
  transform: translateY(-2px);
  border-color: var(--line-strong);
}

.theme-toggle-icon {
  width: 18px;

  display: grid;
  place-items: center;

  color: var(--green);

  font-size: 17px;
}

.theme-toggle-label {
  font-size: 10px;
  font-weight: 700;
}

.theme-chevron {
  color: var(--muted);

  font-size: 11px;
}

/* =========================================================
   THEME MENU
========================================================= */

.theme-menu {
  position: absolute;
  z-index: 100;

  top: calc(100% + 10px);
  right: 0;

  width: 230px;

  padding: 7px;

  border: 1px solid var(--line-strong);
  border-radius: 15px;

  background: var(--panel);

  box-shadow: var(--shadow);

  animation:
    premiumReveal 0.2s ease both;
}

.theme-menu button {
  width: 100%;

  display: grid;
  grid-template-columns:
    28px 1fr auto;

  align-items: center;
  gap: 8px;

  padding: 10px;

  border: 0;
  border-radius: 10px;

  background: transparent;
  color: var(--text);

  text-align: left;

  transition:
    background-color 0.2s ease;
}

.theme-menu button:hover,
.theme-menu button.active {
  background: var(--green-soft);
}

.theme-menu button > span {
  width: 27px;
  height: 27px;

  display: grid;
  place-items: center;

  border-radius: 8px;

  background: var(--panel-2);

  color: var(--green);

  font-size: 14px;
}

.theme-menu button div {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 2px;
}

.theme-menu strong {
  font-size: 10px;
}

.theme-menu small {
  color: var(--muted);

  font-size: 8px;
}

.theme-menu b {
  color: var(--green);

  font-size: 12px;
}

/* =========================================================
   PRIMARY ACTION
========================================================= */

.primary-action {
  padding: 11px 16px;

  border: 0;
  border-radius: 11px;

  background: var(--green);
  color: #061009;

  font-size: 11px;
  font-weight: 800;

  box-shadow:
    0 8px 25px
    rgba(74, 222, 128, 0.08);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.primary-action:hover {
  box-shadow:
    0 12px 35px
    rgba(74, 222, 128, 0.2);

  transform: translateY(-2px);
}

.mobile-menu {
  display: none;
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 760px) {
  .command-header {
    height: 76px;

    padding: 0 16px;
  }

  .header-actions {
    gap: 7px;
  }

  .theme-toggle {
    width: 38px;
    height: 36px;

    justify-content: center;

    padding: 0;
  }

  .theme-toggle-label,
  .theme-chevron {
    display: none;
  }

  .theme-menu {
    right: -5px;
  }

  .header-icon {
    width: 36px;
    height: 36px;
  }
}

@media (max-width: 500px) {
  .theme-control {
    order: 1;
  }

  .notification {
    display: none;
  }

  .header-record-button {
    order: 2;

    padding: 9px 11px;

    font-size: 9px;
  }

  .record-arrow {
    display: none;
  }
}

@media (max-width: 390px) {
  .header-record-button {
    font-size: 8px;

    padding: 8px 9px;
  }

  .command-header h1 {
    font-size: 15px;
  }
}

/* =========================================================
   THEME DROPDOWN — FRONT LAYER
========================================================= */

.command-header {
  position: relative;
  z-index: 1000;
}

.header-actions {
  position: relative;
  z-index: 1001;
}

.theme-control {
  position: relative;
  z-index: 1002;
}

.theme-menu {
  position: absolute !important;
  z-index: 99999 !important;

  top: calc(100% + 12px);
  right: 0;

  opacity: 1 !important;

  background: var(--panel) !important;
  color: var(--text);

  border: 1px solid var(--line-strong) !important;

  box-shadow:
    0 24px 65px rgba(0, 0, 0, 0.45);

  isolation: isolate;
}

html[data-theme="light"] .theme-menu {
  box-shadow:
    0 24px 65px rgba(16, 31, 23, 0.18);
}

